  "mobile_app_submission_flow": {
    "step_1_version_check": {
      "api_call": "GET /api/intervention-assessment/68cbb0975a26e73b61e061d3/version-info",
      "response": {
        "interventionId": "68cbb0975a26e73b61e061d3",
        "revisionNumber": 2,
        "hasBeenRevised": true,
        "questions": "... VERSION 2 questions ..."
      }
    },

    "step_2_response_submission": {
      "api_call": "POST /api/intervention-responses",
      "request_body": {
        "studentId": 202210222,
        "interventionAssessmentId": "68cbb0975a26e73b61e061d3",
        "revisionNumber": 2,
        "responses": [
          {
            "questionId": "int_pa_001_v2",
            "response": [
              {"audio": "B", "match": "Bb"},
              {"audio": "P", "match": "Pp"}
            ],
            "isCorrect": true,
            "correctMatches": 2,
            "totalMatches": 2,
            "responseTime": 8.5,
            "answeredAt": "2025-01-17T09:15:30Z"
          }
        ],
        "completedAt": "2025-01-17T09:20:00Z"
      }
    },

    "step_3_backend_processing": {
      "creates_individual_records": "One intervention_responses record per question answered",
      "triggers_results_analysis": "InterventionResultsAnalysisService.generateComprehensiveResults()",
      "updates_intervention_assessment": "Adds to interventionResults[] array with revisionNumber: 2"
    }
  },

  "critical_validation_rules": {
    "revisionNumber_matching": {
      "rule": "intervention_responses.revisionNumber MUST match intervention_assessment.revisionNumber",
      "example": "If student takes VERSION 2, revisionNumber MUST be 2"
    },

    "intervention_id_consistency": {
      "rule": "interventionAssessmentId stays the same across all versions",
      "example": "VERSION 1, 2, 3 all use same interventionAssessmentId"
    },

    "question_id_versioning": {
      "rule": "questionId should reflect version (optional but recommended)",
      "examples": {
        "version_1": "int_pa_001_v1",
        "version_2": "int_pa_001_v2",
        "version_3": "int_pa_001_v3"
      }
    },

    "completeness_validation": {
      "rule": "Must answer ALL questions in intervention before creating intervention_results",
      "check": "COUNT(intervention_responses) >= intervention_assessment.totalQuestions"
    }
  },

  "backend_model_schema_reference": {
    "file": "/Users/goodboykit/Documents/Dyslexia/backend/models/interventionResponseModel.js",
    "key_fields": {
      "interventionAssessmentId": "ObjectId, ref: 'InterventionAssessment'",
      "revisionNumber": "Number, default: 1",
      "studentId": "Number, required: true",
      "questionId": "String, required: true",
      "category": "String, required: true",
      "response": "Schema.Types.Mixed",
      "isCorrect": "Boolean, required: true"
    }
  }
}