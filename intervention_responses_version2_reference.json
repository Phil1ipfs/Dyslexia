{
  "intervention_responses_version_2_attributes": {
    "description": "Required attributes for intervention_responses when student takes VERSION 2",

    "collection_name": "test.intervention_responses",

    "required_attributes": {
      "_id": {
        "type": "ObjectId",
        "description": "MongoDB auto-generated unique identifier",
        "example": "ObjectId('65a8e9876543210987654321')"
      },

      "studentId": {
        "type": "Number",
        "description": "Student's ID number",
        "required": true,
        "example": 202210222
      },

      "interventionAssessmentId": {
        "type": "ObjectId",
        "description": "Links to intervention_assessment._id (SAME ID for all versions)",
        "required": true,
        "example": "ObjectId('68cbb0975a26e73b61e061d3')",
        "note": "This stays the same across all versions - VERSION 1, 2, 3 use same intervention ID"
      },

      "revisionNumber": {
        "type": "Number",
        "description": "CRITICAL: Which version of intervention student took",
        "required": true,
        "example": 2,
        "note": "VERSION 2 = revisionNumber: 2, VERSION 3 = revisionNumber: 3"
      },

      "questionId": {
        "type": "String",
        "description": "Specific question ID from VERSION 2 questions",
        "required": true,
        "example": "int_pa_001_v2",
        "note": "Each version may have different questionIds"
      },

      "category": {
        "type": "String",
        "description": "Reading category being assessed",
        "required": true,
        "enum": ["Alphabet Knowledge", "Phonological Awareness", "Decoding", "Word Recognition", "Reading Comprehension"],
        "example": "Phonological Awareness"
      },

      "response": {
        "type": "Mixed",
        "description": "Student's actual answer - format depends on question type",
        "required": true,
        "examples": {
          "phonological_awareness_matching": [
            {"audio": "B", "match": "Bb"},
            {"audio": "P", "match": "Pp"}
          ],
          "alphabet_knowledge_choice": "a",
          "reading_comprehension_array": ["Juan", "Parke", "Bulaklak"]
        }
      },

      "isCorrect": {
        "type": "Boolean",
        "description": "Whether the overall question response is correct",
        "required": true,
        "example": true
      },

      "answeredAt": {
        "type": "Date",
        "description": "When student answered this question",
        "required": true,
        "example": "2025-01-17T09:15:30Z"
      },

      "createdAt": {
        "type": "Date",
        "description": "When this response record was created",
        "required": true,
        "example": "2025-01-17T09:15:30Z"
      }
    },

    "category_specific_attributes": {
      "phonological_awareness": {
        "correctMatches": {
          "type": "Number",
          "description": "How many audio-letter pairs matched correctly",
          "example": 2
        },
        "totalMatches": {
          "type": "Number",
          "description": "Total possible matches for this question",
          "example": 2
        }
      },

      "reading_comprehension": {
        "sentenceResults": {
          "type": "Array",
          "description": "Individual sentence question results (all-or-nothing scoring)",
          "example": [
            {
              "questionNumber": 1,
              "questionText": "Sino ang pangunahing tauhan?",
              "studentAnswer": "Juan",
              "correctAnswer": "Juan",
              "isCorrect": true
            }
          ]
        },
        "correctSentenceQuestions": {
          "type": "Number",
          "description": "How many sentence questions correct",
          "example": 3
        },
        "totalSentenceQuestions": {
          "type": "Number",
          "description": "Total sentence questions for this questionId",
          "example": 3
        },
        "allOrNothingScoring": {
          "type": "Boolean",
          "description": "Always true for Reading Comprehension",
          "example": true
        }
      }
    },

    "optional_attributes": {
      "responseTime": {
        "type": "Number",
        "description": "Seconds taken to answer (for BKT analysis)",
        "example": 8.5
      },

      "readingLevel": {
        "type": "String",
        "description": "Student's reading level when answering",
        "example": "High Emerging"
      }
    }
  },

