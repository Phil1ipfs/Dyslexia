# Redirects and Rewrites for Single Page Application (SPA)
# This file ensures all routes are handled by React Router

# API proxy - redirect API calls to backend EC2 server
# CRITICAL: This must come BEFORE the SPA fallback rule
/api/*  https://api.literexia.com/api/:splat  200

# Remove trailing slashes from URLs
/*/  /:splat  301!

# SPA fallback - redirect all non-file requests to index.html
# This is essential for React Router to work correctly
/*    /index.html   200

# Force HTTPS redirects (optional)
# http://your-domain.com/*  https://your-domain.com/:splat  301!

# Handle specific file extensions
/*.js    /:splat  200
/*.css   /:splat  200
/*.png   /:splat  200
/*.jpg   /:splat  200
/*.ico   /:splat  200
/*.svg   /:splat  200
/*.woff  /:splat  200
/*.woff2 /:splat  200
/*.ttf   /:splat  200
/*.json  /:splat  200