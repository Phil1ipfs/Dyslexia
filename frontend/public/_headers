# Security Headers for AWS Amplify Deployment
# OWASP ZAP Security Compliance Configuration
# This file configures security headers for all routes

# ROOT PATH - HTML FILES (highest priority)
/
  # OWASP ZAP Fix: Content Security Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://literexia.com https://*.amazonaws.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://literexia.com https://*.amazonaws.com https://*.sentry.io wss: ws:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

  # OWASP ZAP Fix: Anti-clickjacking Header
  X-Frame-Options: DENY

  # OWASP ZAP Fix: MIME-sniffing protection
  X-Content-Type-Options: nosniff

  # OWASP ZAP Fix: Strict-Transport-Security (HSTS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # XSS protection
  X-XSS-Protection: 1; mode=block

  # Referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Feature policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()

  # OWASP ZAP Fix: Cache-Control for HTML (no caching for dynamic content)
  Cache-Control: no-cache, no-store, must-revalidate, private
  Pragma: no-cache
  Expires: 0

# STATIC ASSETS - JavaScript, CSS, Images
/assets/*
  # OWASP ZAP Fix: All security headers on static assets
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://literexia.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

  # Cache-Control for immutable assets (with hash in filename)
  Cache-Control: public, max-age=31536000, immutable

# API routes (if any are served from the same domain)
/api/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'none'; img-src 'none'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'

# ROBOTS.TXT - OWASP ZAP Fix
/robots.txt
  # Security headers for robots.txt
  Content-Security-Policy: default-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  # Cache for 1 day
  Cache-Control: public, max-age=86400

# SITEMAP.XML - OWASP ZAP Fix
/sitemap.xml
  # Security headers for sitemap.xml
  Content-Security-Policy: default-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Type: application/xml
  # Cache for 1 day
  Cache-Control: public, max-age=86400

# MANIFEST.JSON - OWASP ZAP Fix
/manifest.json
  # Security headers for manifest
  Content-Security-Policy: default-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-XSS-Protection: 1; mode=block
  Content-Type: application/manifest+json
  # OWASP ZAP Fix: Cache-Control (no conflicting directives)
  Cache-Control: public, max-age=86400

# Service worker
/sw.js
  # Security headers
  Content-Security-Policy: default-src 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # No cache for service worker
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0