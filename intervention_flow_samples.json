    "frontend_validation_logic": {
      "version_awareness": {
        "currentRevision": "intervention.revisionNumber || 1",
        "hasBeenRevised": "currentRevision > 1",
        "hasCurrentVersionResults": "interventionResultData && interventionResultData.revisionNumber === currentRevision"
      },

      "button_states": {
        "edit_disabled_when": [
          "hasBeenRevised && !hasCurrentVersionResults",
          "intervention.status === 'active' && !failed_current_version"
        ],
        "view_responses_visible_when": [
          "hasCurrentVersionResults === true"
        ]
      }
    }
